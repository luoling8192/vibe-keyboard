<UserControl x:Class="VibeKeyboardApp.Views.FirmwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Firmware" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="#F0F0F0" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="USB Serial/JTAG is the only device transport."
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Destructive firmware, storage, and LED calibration actions require separate authorization."
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="ROM flash only status applies only to firmware updates. It does not disable keys, screen assets, or USB audio."
                               Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
