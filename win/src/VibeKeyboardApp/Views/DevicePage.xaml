<UserControl x:Class="VibeKeyboardApp.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VibeKeyboardApp.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Device" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="#F0F0F0" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Connection" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Transport:"/>
                        <TextBlock Grid.Column="1" Text="USB Serial/JTAG"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Status:"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionTitle}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Device:"/>
                        <TextBlock Grid.Column="1" Text="{Binding DeviceID}"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Firmware:"/>
                        <TextBlock Grid.Column="1" Text="{Binding FirmwareVersion}"/>
                    </Grid>

                    <Separator Margin="0,8"/>
                    <TextBlock Text="Capabilities" FontWeight="Bold" Margin="0,8,0,4"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Assets"/>
                        <TextBlock Grid.Column="1" Text="{Binding AssetsCapability}" Foreground="Gray"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Screen"/>
                        <TextBlock Grid.Column="1" Text="{Binding ScreenCapability}" Foreground="Gray"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LED"/>
                        <TextBlock Grid.Column="1" Text="{Binding LEDCapability}" Foreground="Gray"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Firmware updates"/>
                        <TextBlock Grid.Column="1" Text="{Binding UpdateCapability}" Foreground="Gray"/>
                    </Grid>

                    <Button Content="Reconnect" Margin="0,12,0,0" Padding="16,4"
                            Click="Reconnect_Click"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
